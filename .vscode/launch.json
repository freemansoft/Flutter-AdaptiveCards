{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Widgetbook - Current",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/widgetbook",
      "program": "lib/main.dart",
      "args": []
    },
    {
      // Sections with images may fail in chrome because of HTTPS CORS issues
      // Use --disable-web-security to disable CORS
      "name": "Widgetbook - Web",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/widgetbook",
      "program": "lib/main.dart",
      "args": [
        "--web-browser-flag=--disable-web-security",
        "-d",
        "chrome",
        "--web-port",
        "3000"
      ]
    },
    {
      "name": "Adaptive Explorer - Current",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/adaptive_explorer",
      "program": "lib/main.dart",
      "args": []
    },
    {
      "name": "Adaptive Chat Client - Current",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/adaptive_chat_client",
      "program": "lib/main.dart",
      "args": []
    },
    {
      // Talks to the chat server on :8000. --disable-web-security avoids
      // local CORS friction when running the app in Chrome during development.
      "name": "Adaptive Chat Client - Web",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/adaptive_chat_client",
      "program": "lib/main.dart",
      "args": [
        "--web-browser-flag=--disable-web-security",
        "-d",
        "chrome",
        "--web-port",
        "3000"
      ]
    },
    {
      // Runs the shelf server directly via the Dart VS Code extension.
      // --echo is required: the server talks to Ollama by default, so the echo
      // demo is now opt-in rather than what you get by passing nothing.
      "name": "Adaptive Chat Server Dart (echo)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": ["--echo", "--port", "8000"]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull qwen2.5-coder:7b`).
      "name": "Adaptive Chat Server Dart (Ollama qwen2.5-coder:7b)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen2.5-coder:7b",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull gpt-oss:20b`).
      "name": "Adaptive Chat Server Dart (Ollama gpt-oss:20b)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "gpt-oss:20b",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull qwen3.5:9b`).
      "name": "Adaptive Chat Server Dart (Ollama qwen3.5:9b)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen3.5:9b",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Adaptive Card replies are the server default, so the plain Ollama
      // configurations above already produce cards. This one opts back OUT,
      // pointing at assets/default_system_prompt.txt for Markdown-only
      // replies — useful for comparing the two prompts on the same model.
      "name": "Adaptive Chat Server Dart (Ollama qwen2.5-coder:7b, markdown prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen2.5-coder:7b",
        "--system-prompt-file",
        "assets/default_system_prompt.txt",
        "--json-format",
        "none",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      "name": "Adaptive Chat Server Dart (Ollama gpt-oss:20b, markdown prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "gpt-oss:20b",
        "--system-prompt-file",
        "assets/default_system_prompt.txt",
        "--json-format",
        "none",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      "name": "Adaptive Chat Server Dart (Ollama qwen3.5:9b, markdown prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen3.5:9b",
        "--system-prompt-file",
        "assets/default_system_prompt.txt",
        "--json-format",
        "none",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Adaptive Chat (server + web)",
      "configurations": [
        "Adaptive Chat Server Dart (echo)",
        "Adaptive Chat Client - Web"
      ]
    },
    {
      "name": "Adaptive Chat (Ollama gpt-oss + web)",
      "configurations": [
        "Adaptive Chat Server Dart (Ollama gpt-oss:20b)",
        "Adaptive Chat Client - Web"
      ]
    },
    {
      "name": "Adaptive Chat (markdown-mode Ollama gpt-oss server + web)",
      "configurations": [
        "Adaptive Chat Server Dart (Ollama gpt-oss:20b, markdown prompt)",
        "Adaptive Chat Client - Web"
      ]
    }
  ]
}