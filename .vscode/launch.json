{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Widgetbook - Current",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/widgetbook",
      "program": "lib/main.dart",
      "args": []
    },
    {
      // Sections with images may fail in chrome because of HTTPS CORS issues
      // Use --disable-web-security to disable CORS
      "name": "Widgetbook - Web",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/widgetbook",
      "program": "lib/main.dart",
      "args": [
        "--web-browser-flag=--disable-web-security",
        "-d",
        "chrome",
        "--web-port",
        "3000"
      ]
    },
    {
      "name": "Adaptive Explorer - Current",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/adaptive_explorer",
      "program": "lib/main.dart",
      "args": []
    },
    {
      "name": "Adaptive Chat Client - Current",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/adaptive_chat_client",
      "program": "lib/main.dart",
      "args": []
    },
    {
      // Talks to the chat server on :8000. --disable-web-security avoids
      // local CORS friction when running the app in Chrome during development.
      "name": "Adaptive Chat Client - Web",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/adaptive_chat_client",
      "program": "lib/main.dart",
      "args": [
        "--web-browser-flag=--disable-web-security",
        "-d",
        "chrome",
        "--web-port",
        "3000"
      ]
    },
    {
      // Runs the shelf server directly via the Dart VS Code extension.
      //
      // Every configuration below names its reply mode explicitly, because the
      // server has no default and refuses to start without one. --echo is this
      // one's mode: no model is called, so the Ollama and prompt flags the
      // other configurations carry would do nothing here.
      "name": "Adaptive Chat Server Dart (echo)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--echo",
        "--log-level",
        "debug",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull qwen2.5-coder:7b`). 16 GB 2 of 2, and the compiled-in
      // default (defaultOllamaModel), so it is the one configuration that
      // must stay launchable by hand. Seed-neutral, and the most
      // card-committed model measured: 10/10 stress with zero prose.
      "name": "Adaptive Chat Server Dart (Ollama qwen2.5-coder:7b, card prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen2.5-coder:7b",
        "--system-prompt-file",
        "assets/card_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull qwen3.8:27b-nvfp4`). LARGE 1 of 2: the highest
      // as-shipped shape score measured, 24/25, and seed-neutral — it scores
      // the same with the seed and without it. Leave --json-format at none:
      // this model ignores the constraint silently.
      // See adaptive_chat_server_dart/ModelBehavior.md.
      "name": "Adaptive Chat Server Dart (Ollama qwen3.8:27b-nvfp4, card prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen3.8:27b-nvfp4",
        "--system-prompt-file",
        "assets/card_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull granite4.1:8b`). 16 GB 1 of 2: the best portable model
      // at 21/25, and one the seed does real work for — it scores 15/25
      // without it. Launch this beside the qwen3-coder target below to see
      // both halves of why --seed-card is a flag rather than a constant.
      "name": "Adaptive Chat Server Dart (Ollama granite4.1:8b, card prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "granite4.1:8b",
        "--system-prompt-file",
        "assets/card_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull qwen3-coder:30b`). LARGE 2 of 2, added 2026-08-21.
      // Chosen for demo qualities rather than raw coverage: at 1.6 s/call it
      // is the fastest model measured, it honors --json-format (neither nvfp4
      // build does), and it is the only model that answers BOTH cold-start
      // sets entirely in cards, never falling back to Markdown.
      //
      // It is also the strongest demonstration of what the card seed buys:
      // 23/25 with the seed, 14/25 without. Relaunch this target with
      // --no-seed-card to watch it fall apart, which is the point of the flag
      // existing. See adaptive_chat_server_dart/ModelBehavior.md.
      "name": "Adaptive Chat Server Dart (Ollama qwen3-coder:30b, card prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen3-coder:30b",
        "--system-prompt-file",
        "assets/card_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Opts OUT of Adaptive Cards: assets/default_system_prompt.txt makes the
      // model answer in Markdown. Useful for comparing the two prompts on the
      // same model — same flags as the card trio above, prompt file aside.
      "name": "Adaptive Chat Server Dart (Ollama qwen2.5-coder:7b, markdown prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen2.5-coder:7b",
        "--system-prompt-file",
        "assets/default_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull qwen3.8:27b-nvfp4`).
      "name": "Adaptive Chat Server Dart (Ollama qwen3.8:27b-nvfp4, markdown prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen3.8:27b-nvfp4",
        "--system-prompt-file",
        "assets/default_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull granite4.1:8b`).
      "name": "Adaptive Chat Server Dart (Ollama granite4.1:8b, markdown prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "granite4.1:8b",
        "--system-prompt-file",
        "assets/default_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Adaptive Chat (echo server + web)",
      "configurations": [
        "Adaptive Chat Server Dart (echo)",
        "Adaptive Chat Client - Web"
      ]
    },
    {
      "name": "Adaptive Chat (card-mode Ollama qwen3.8 server + web)",
      "configurations": [
        "Adaptive Chat Server Dart (Ollama qwen3.8:27b-nvfp4, card prompt)",
        "Adaptive Chat Client - Web"
      ]
    },
    {
      "name": "Adaptive Chat (markdown-mode Ollama qwen3.8 server + web)",
      "configurations": [
        "Adaptive Chat Server Dart (Ollama qwen3.8:27b-nvfp4, markdown prompt)",
        "Adaptive Chat Client - Web"
      ]
    }
  ]
}