{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Widgetbook - Current",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/widgetbook",
      "program": "lib/main.dart",
      "args": []
    },
    {
      // Sections with images may fail in chrome because of HTTPS CORS issues
      // Use --disable-web-security to disable CORS
      "name": "Widgetbook - Web",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/widgetbook",
      "program": "lib/main.dart",
      "args": [
        "--web-browser-flag=--disable-web-security",
        "-d",
        "chrome",
        "--web-port",
        "3000"
      ]
    },
    {
      "name": "Adaptive Explorer - Current",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/adaptive_explorer",
      "program": "lib/main.dart",
      "args": []
    },
    {
      "name": "Adaptive Chat Client - Current",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/adaptive_chat_client",
      "program": "lib/main.dart",
      "args": []
    },
    {
      // Talks to the chat server on :8000. --disable-web-security avoids
      // local CORS friction when running the app in Chrome during development.
      "name": "Adaptive Chat Client - Web",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/adaptive_chat_client",
      "program": "lib/main.dart",
      "args": [
        "--web-browser-flag=--disable-web-security",
        "-d",
        "chrome",
        "--web-port",
        "3000"
      ]
    },
    {
      // Runs the shelf server directly via the Dart VS Code extension.
      //
      // Every configuration below names its reply mode explicitly, because the
      // server has no default and refuses to start without one. --echo is this
      // one's mode: no model is called, so the Ollama and prompt flags the
      // other configurations carry would do nothing here.
      "name": "Adaptive Chat Server Dart (echo)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--echo",
        "--log-level",
        "debug",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull qwen2.5-coder:7b`).
      "name": "Adaptive Chat Server Dart (Ollama qwen2.5-coder:7b, card prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen2.5-coder:7b",
        "--system-prompt-file",
        "assets/card_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull gpt-oss:20b`).
      "name": "Adaptive Chat Server Dart (Ollama gpt-oss:20b, card prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "gpt-oss:20b",
        "--system-prompt-file",
        "assets/card_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull qwen3.5:9b`).
      "name": "Adaptive Chat Server Dart (Ollama qwen3.5:9b, card prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen3.5:9b",
        "--system-prompt-file",
        "assets/card_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Opts OUT of Adaptive Cards: assets/default_system_prompt.txt makes the
      // model answer in Markdown. Useful for comparing the two prompts on the
      // same model — same flags as the card trio above, prompt file aside.
      "name": "Adaptive Chat Server Dart (Ollama qwen2.5-coder:7b, markdown prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen2.5-coder:7b",
        "--system-prompt-file",
        "assets/default_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull gpt-oss:20b`).
      "name": "Adaptive Chat Server Dart (Ollama gpt-oss:20b, markdown prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "gpt-oss:20b",
        "--system-prompt-file",
        "assets/default_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    },
    {
      // Requires a local Ollama (`ollama serve`) with the model pulled
      // (`ollama pull qwen3.5:9b`).
      "name": "Adaptive Chat Server Dart (Ollama qwen3.5:9b, markdown prompt)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/adaptive_chat_server_dart",
      "program": "bin/server.dart",
      "args": [
        "--ollama-url",
        "http://127.0.0.1:11434",
        "--log-level",
        "debug",
        "--ollama-model",
        "qwen3.5:9b",
        "--system-prompt-file",
        "assets/default_system_prompt.txt",
        "--num-ctx",
        "16384",
        "--history-turns",
        "10",
        "--port",
        "8000"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Adaptive Chat (echo server + web)",
      "configurations": [
        "Adaptive Chat Server Dart (echo)",
        "Adaptive Chat Client - Web"
      ]
    },
    {
      "name": "Adaptive Chat (card-mode Ollama gpt-oss server + web)",
      "configurations": [
        "Adaptive Chat Server Dart (Ollama gpt-oss:20b, card prompt)",
        "Adaptive Chat Client - Web"
      ]
    },
    {
      "name": "Adaptive Chat (markdown-mode Ollama gpt-oss server + web)",
      "configurations": [
        "Adaptive Chat Server Dart (Ollama gpt-oss:20b, markdown prompt)",
        "Adaptive Chat Client - Web"
      ]
    }
  ]
}